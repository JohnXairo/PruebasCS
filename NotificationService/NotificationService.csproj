<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NotificationService</RootNamespace>
    <AssemblyName>NotificationService</AssemblyName>
    <!--
      Framework-dependent: usa el runtime .NET instalado en el sistema.
      REQUERIDO para que el profiler CLR de Instana pueda inyectarse correctamente.
    -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"                  Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore"                        Version="6.5.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices"  Version="8.0.0" />
  </ItemGroup>

</Project>
